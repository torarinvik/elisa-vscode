enum Event:
    None
    Quit
    Resize(size: Size)

enum PointerEvent is InputEvent:
    Move(at: Vec2)

def consume(event: Event) -> i32:
    match event:
        Event.None:
            return 0
        Event.Resize(size):
            return 1

def call_tool():
    raw.UiKey()
    tool.Method(1)
    return 0

struct Vec2:
    x: i32
    y: i32

struct Size:
    width: i32
    height: i32

struct InputEvent:
    kind: i32

def make_event() -> Event:
    return Event.Resize(1)

struct Rect:
    origin: Vec2
    size: Size
    på: Vec2

def shadow_family(Event: i32) -> i32:
    return Event.Resize(2)

module Ui:
    public:
        enum Event:
            None
            Resize(size: i32)

type UiEvent = Ui::Event

def consume_ui(event: UiEvent) -> i32:
    match event:
        Ui::Event.None:
            return 0
        Ui::Event.Resize(size):
            return size

def make_ui_event() -> UiEvent:
    return Ui::Event.Resize(1)

type EventAlias = Event

def make_alias_event() -> EventAlias:
    return EventAlias.Resize(1)

def consume_alias_event(event: EventAlias) -> i32:
    match event:
        EventAlias.Resize(size):
            return size
