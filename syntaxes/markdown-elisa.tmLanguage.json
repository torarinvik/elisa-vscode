{
  "scopeName": "markdown.elisa.fenced-code",
  "injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown - comment",
  "patterns": [
    {
      "begin": "^ {0,3}(`{3,})[ \\t]*(?i:(elisa))(?=[ \\t]|$)[^`\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.fenced.markdown"
        },
        "2": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "end": "^ {0,3}\\1`*[ \\t]*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.fenced.markdown"
        }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.elisa",
      "patterns": [
        {
          "include": "source.elisa"
        }
      ]
    },
    {
      "begin": "^ {0,3}(~{3,})[ \\t]*(?i:(elisa))(?=[ \\t]|$)[^\\n]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.fenced.markdown"
        },
        "2": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "end": "^ {0,3}\\1~*[ \\t]*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.fenced.markdown"
        }
      },
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.elisa",
      "patterns": [
        {
          "include": "source.elisa"
        }
      ]
    }
  ]
}
