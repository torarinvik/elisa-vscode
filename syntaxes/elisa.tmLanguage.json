{
  "name": "Elisa",
  "scopeName": "source.elisa",
  "fileTypes": [
    "elisa"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#enumBlock"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#moduleReferences"
    },
    {
      "include": "#typeReferences"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "name": "variable.other.elisa",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.elisa",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#tripleQuotedString"
        },
        {
          "include": "#interpolatedString"
        },
        {
          "include": "#doubleQuotedString"
        },
        {
          "include": "#singleQuotedString"
        }
      ]
    },
    "tripleQuotedString": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.elisa"
    },
    "interpolatedString": {
      "begin": "\\bf\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.elisa"
        }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.elisa"
        }
      },
      "contentName": "string.quoted.double.fstring.elisa",
      "patterns": [
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.brace.elisa"
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.begin.elisa"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.interpolation.end.elisa"
            }
          },
          "contentName": "meta.embedded.expression.elisa",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "include": "#stringEscapes"
        }
      ]
    },
    "doubleQuotedString": {
      "begin": "\"",
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.elisa"
        }
      },
      "name": "string.quoted.double.elisa",
      "patterns": [
        {
          "include": "#stringEscapes"
        }
      ]
    },
    "singleQuotedString": {
      "begin": "'",
      "end": "(')|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.elisa"
        }
      },
      "name": "string.quoted.single.elisa",
      "patterns": [
        {
          "include": "#stringEscapes"
        }
      ]
    },
    "stringEscapes": {
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.elisa"
        }
      ]
    },
    "enumBlock": {
      "begin": "^([ \\t]*)(const[ \\t]+)?(enum)([ \\t]+)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "beginCaptures": {
        "2": {
          "name": "storage.type.declaration.elisa"
        },
        "3": {
          "name": "storage.type.declaration.elisa"
        },
        "5": {
          "name": "entity.name.type.enum.elisa"
        }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#variantDeclaration"
        },
        {
          "include": "#moduleReferences"
        },
        {
          "include": "#typeReferences"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#decorators"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "name": "variable.other.elisa",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "variantDeclaration": {
      "patterns": [
        {
          "match": "^([ \\t]+)([A-Z][A-Za-z0-9_]*)(?=[ \\t]*(?:\\(|:|$|,|=))",
          "captures": {
            "2": {
              "name": "variable.other.enummember.elisa"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(export)[ \\t]+fn[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.export.elisa"
            },
            "2": {
              "name": "entity.name.function.elisa"
            }
          }
        },
        {
          "match": "\\b(extern)[ \\t]+fn[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.extern.elisa"
            },
            "2": {
              "name": "entity.name.function.elisa"
            }
          }
        },
        {
          "match": "\\b(def|extern|fn)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.elisa"
            },
            "2": {
              "name": "entity.name.function.elisa"
            }
          }
        },
        {
          "match": "\\b(struct)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.elisa"
            },
            "2": {
              "name": "entity.name.type.struct.elisa"
            }
          }
        },
        {
          "match": "\\b(enum)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.elisa"
            },
            "2": {
              "name": "entity.name.type.enum.elisa"
            }
          }
        },
        {
          "match": "\\b(type|alias|protocol|effect|permission|law)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.elisa"
            },
            "2": {
              "name": "entity.name.type.elisa"
            }
          }
        },
        {
          "match": "\\b(global|const)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.binding.elisa"
            },
            "2": {
              "name": "variable.other.constant.elisa"
            }
          }
        },
        {
          "match": "\\b(module)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.elisa"
            },
            "2": {
              "name": "entity.name.namespace.elisa"
            }
          }
        }
      ]
    },
    "moduleReferences": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)",
          "captures": {
            "1": {
              "name": "entity.name.namespace.elisa"
            },
            "2": {
              "name": "punctuation.separator.namespace.elisa"
            }
          }
        }
      ]
    },
    "typeReferences": {
      "patterns": [
        {
          "match": "(:|->|\\bas\\b|\\bis\\b)[ \\t]*([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.elisa"
            },
            "2": {
              "name": "entity.name.type.elisa"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.elisa",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.binary.elisa",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.octal.elisa",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.float.elisa",
          "match": "\\b(?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)\\b"
        },
        {
          "name": "constant.numeric.integer.elisa",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.elisa",
          "match": "\\b(?:if|elif|else|while|for|in|break|continue|return|pass|match|try|catch|raise|panic|error|defer|guard|do|get|rebind|when)\\b"
        },
        {
          "name": "keyword.declaration.elisa",
          "match": "\\b(?:def|extern|struct|enum|const|global|export|packed|repr|aligned|is|with|as|to|static|include|using|public|private|extend|type|alias|affine|linear|layout|common|of|at|mutable|fn)\\b"
        },
        {
          "name": "keyword.other.effect.elisa",
          "match": "\\b(?:can|uses|trusted|Unsafe|raises|requires|ensure|ensures|invariant|decreases|changes|preserves|fulfills)\\b"
        },
        {
          "name": "keyword.other.contract.elisa",
          "match": "\\b(?:forall|exists|where|ghost|lemma|law|permission|effect|protocol|impl)\\b"
        },
        {
          "name": "keyword.other.elisa",
          "match": "\\b(?:region|destroy|perm|owner|new|heap|stack|tail|move|generate|emit|sizeof|alignof|offsetof|parallel|nursery|pool|submit|await|wait|lock|spawn_daemon)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.elisa",
          "match": "\\b(?:bool|char|void|int|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|uintptr|f32|f64|cstr|dstr|sview|darray|dict|set|view|array|id|Self|Arena)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.elisa",
          "match": "\\b(?:true|false|null|zeroed)\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.elisa",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.elisa",
          "match": "<<=|>>=|<-|:=|\\+=|-=|\\*=|/=|%=|\\^=|\\|=|&=|\\?=|="
        },
        {
          "name": "keyword.operator.bitwise.elisa",
          "match": "<<|>>|&&|\\|\\||&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.elisa",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.elisa",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.elisa",
          "match": "=>|->|\\.\\.<=|\\.\\.>=|\\.\\.<|\\.\\.>|\\.\\.|\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.elisa",
          "match": "[(){}\\[\\],:;.?!]"
        }
      ]
    }
  }
}
